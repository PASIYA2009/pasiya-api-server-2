{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pasiya-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  // IMPORTANT: keeps every variable you add in the Cloudflare dashboard (Settings > Variables and Secrets).
  // Without this, each `wrangler deploy` / Git redeploy DELETES dashboard variables that are not listed in "vars" below.
  "keep_vars": true,
  // Only non-changing values live here. Everything else (ADMIN_EMAIL, FIREBASE_WEB_API_KEY, COBALT_API_URL, ...)
  // is set in the dashboard and survives redeploys. A name listed here would OVERRIDE the dashboard value, so do not repeat dashboard names here.
  "vars": {
    "FIREBASE_PROJECT_ID": "pasiya-api"
  }
}
