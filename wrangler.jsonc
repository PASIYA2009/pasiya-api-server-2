{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pasiya-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "pasiya-api",
